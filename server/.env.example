# Скопируйте в server/.env и подставьте свои значения. Файл .env в git не попадает.

# Порт, на котором слушает сервер.
PORT=3000

# Строка подключения к базе. Для локального Docker-окружения из
# docker-compose.yml в корне проекта - именно такая (порт 5433 снаружи).
DATABASE_URL=postgresql://clh:clh_dev_password@localhost:5433/cover_letter_helper

# Единственный токен доступа. Расширение присылает его в заголовке
# Authorization: Bearer <токен>. Придумайте длинную случайную строку, например
# результат команды: openssl rand -hex 32
API_TOKEN=замените_на_случайную_строку

# ID расширения, которому разрешено обращаться к серверу (CORS).
# Виден на chrome://extensions под названием расширения в режиме разработчика.
EXTENSION_ID=

# Ключи провайдеров. Нужны начиная со среза 3 (перенос генерации на сервер),
# на срезах 0-2 можно оставить пустыми.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Провайдер и модель по умолчанию.
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=
