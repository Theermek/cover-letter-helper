{
  "name": "cover-letter-helper-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for the AI Cover Letter Assistant extension",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.32.4",
    "supertest": "^7.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
